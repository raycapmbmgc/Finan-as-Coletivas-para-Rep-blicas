<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Metas e Fundo de Reserva | Rateio+</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

<div class="container">

    <aside class="sidebar">

        <div class="logo">
            <h2>Rateio+</h2>
        </div>

        <nav>
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/despesas">Despesas</a></li>
                <li><a href="/saldos">Quem Deve Para Quem</a></li>
                <li><a href="/grupos">Membros</a></li>
                <li><a href="/metas">Fundo de Reserva</a></li>
                <li><a href="#">Configurações</a></li>
            </ul>
        </nav>

    </aside>

    <main class="content">

        <header class="header">
            <h1>Fundo de Reserva e Metas</h1>
            <p>Acompanhe as economias do grupo.</p>
        </header>

        <section class="fundo-reserva">

            <h2>Fundo de Reserva</h2>

           <div class="card-saldo">
    <h3>💰 Saldo Atual</h3>

    <p style="
        font-size: 32px;
        font-weight: bold;
        color: <%= saldo >= 0 ? '#2ecc71' : '#e74c3c' %>;
    >
        R$ <%= Number(saldo).toFixed(2) %>
    </p>
</div>

            <div class="acoes-fundo">

         
                <form action="/metas/<%= grupoId %>/entrada" method="POST">
                    <input type="number" name="valor" placeholder="Valor entrada" required>
                    <input type="text" name="responsavel" placeholder="Responsável" required>
                    <button type="submit">Adicionar Valor</button>
                </form>

           
                <form action="/metas/<%= grupoId %>/saida" method="POST">
                    <input type="number" name="valor" placeholder="Valor saída" required>
                    <input type="text" name="responsavel" placeholder="Responsável" required>
                    <button type="submit">Registrar Retirada</button>
                </form>

            </div>

        </section>

        <section class="movimentacoes">

            <h2>Movimentações</h2>

            <table>

                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Responsável</th>
                    </tr>
                </thead>

                <tbody>

                    <% movimentacoes.forEach(m => { %>
                        <tr>
                            <td><%= m.tipo %></td>
                            <td>R$ <%= m.valor %></td>
                            <td><%= m.responsavel %></td>
                        </tr>
                    <% }) %>

                </tbody>

            </table>

        </section>

        <section class="meta-economia">

            <h2>Metas de Economia</h2>

            <% metas.forEach(m => { %>

                <div class="card-meta">

                    <p><strong>Meta:</strong> <%= m.nome %></p>

                    <p><strong>Objetivo:</strong> R$ <%= m.valor_objetivo %></p>

                    <p><strong>Atual:</strong> R$ <%= m.valor_atual %></p>

                    <p><strong>Progresso:</strong> <%= m.progresso %>%</p>

                    <div style="background:#eee; height:10px; border-radius:5px;">
                        <div style="width:<%= m.progresso %>%; background:green; height:10px; border-radius:5px;"></div>
                    </div>

                
                    <a href="/metas/<%= grupoId %>/meta/excluir/<%= m.id %>">
                        <button type="button">Excluir</button>
                    </a>

                </div>

            <% }) %>

        </section>

        <section class="form-meta">

            <h2>Cadastrar Nova Meta</h2>

            <form action="/metas/<%= grupoId %>/meta" method="POST">

                <div class="campo">
                    <label>Nome da Meta</label>
                    <input type="text" name="nomeMeta" placeholder="Ex: Viagem de fim de ano" required>
                </div>

                <div class="campo">
                    <label>Valor Objetivo</label>
                    <input type="number" name="valorMeta" placeholder="2000" required>
                </div>

                <button type="submit">Salvar Meta</button>

            </form>

        </section>

    </main>

</div>

</body>
</html>