<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Despesas | Rateio+</title>
    <link rel="stylesheet" href="css/style.css" />
</head>
<body>

<div class="container">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <h2>Rateio+</h2>
        </div>

        <nav>
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/despesas">Despesas</a></li>
                <li><a href="/saldos">Quem Deve Para Quem</a></li>
                <li><a href="/grupos">Membros</a></li>
                <li><a href="/metas">Fundo de Reserva</a></li>
                <li><a href="#">Configurações</a></li>
            </ul>
        </nav>

    </aside>

    <!-- CONTEÚDO -->
    <main class="content">

        <header class="header">
            <h1>Nova Despesa</h1>
            <p>Cadastre uma nova despesa compartilhada.</p>
        </header>

        <!-- FORMULÁRIO -->
        <section class="formulario-despesa">

            <form>

                <div class="campo">
                    <label for="descricao">Descrição</label>
                    <input
                        type="text"
                        id="descricao"
                        name="descricao"
                        placeholder="Ex: Mercado"
                    >
                </div>

                <div class="campo">
                    <label for="valor">Valor</label>
                    <input
                        type="number"
                        id="valor"
                        name="valor"
                        placeholder="0,00"
                    >
                </div>

                <div class="campo">
                    <label for="categoria">Categoria</label>

                    <select id="categoria" name="categoria">
                        <option>Alimentação</option>
                        <option>Transporte</option>
                        <option>Lazer</option>
                        <option>Moradia</option>
                        <option>Outros</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="data">Data</label>
                    <input
                        type="date"
                        id="data"
                        name="data"
                    >
                </div>

                <div class="campo">
                    <label for="pagador">Quem Pagou</label>

                    <select id="pagador" name="pagador">
                        <option>Andrielle</option>
                        <option>Rayca</option>
                        <option>Natalie</option>
                        <option>Tayna</option>
                    </select>
                </div>

                <button type="submit">
                    Salvar Despesa
                </button>

            </form>

        </section>

        <!-- LISTA -->
        <section class="lista-despesas">

            <h2>Despesas Cadastradas</h2>

            <table>

                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Categoria</th>
                        <th>Pagador</th>
                        <th>Data</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Mercado</td>
                        <td>R$ 150,00</td>
                        <td>Alimentação</td>
                        <td>Andrielle</td>
                        <td>01/06/2026</td>
                    </tr>

                    <tr>
                        <td>Internet</td>
                        <td>R$ 120,00</td>
                        <td>Moradia</td>
                        <td>Rayca</td>
                        <td>03/06/2026</td>
                    </tr>

                    <tr>
                        <td>Produtos de Limpeza</td>
                        <td>R$ 85,00</td>
                        <td>Moradia</td>
                        <td>Natalie</td>
                        <td>05/06/2026</td>
                    </tr>

                    <tr>
                        <td>Netflix</td>
                        <td>R$ 45,00</td>
                        <td>Lazer</td>
                        <td>Tayna</td>
                        <td>06/06/2026</td>
                    </tr>

                </tbody>

            </table>

        </section>

    </main>

</div>

</body>
</html>
