<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Despesas | Rateio+</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <h2>Rateio+</h2>
        </div>

        <nav>
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/despesas">Despesas</a></li>
                <li><a href="/saldos">Quem Deve Para Quem</a></li>
                <li><a href="/grupos">Grupos</a></li>
                <li><a href="/metas">Metas</a></li>
                <li><a href="/logout">Sair</a></li>
            </ul>
        </nav>

    </aside>

    <!-- CONTEÚDO -->
    <main class="content">

        <header class="header">
            <h1>Nova Despesa</h1>
            <p>Cadastre uma nova despesa compartilhada.</p>
        </header>

      <form action="/despesas" method="POST">

    <div class="campo">
        <label for="descricao">Descrição</label>
        <input
            type="text"
            id="descricao"
            name="descricao"
            placeholder="Ex: Mercado"
            required
        >
    </div>

    <div class="campo">
        <label for="valor">Valor</label>
        <input
            type="number"
            step="0.01"
            id="valor"
            name="valor"
            placeholder="0.00"
            required
        >
    </div>

    <div class="campo">
        <label for="categoria">Categoria</label>

        <select
            id="categoria"
            name="categoria"
            required
        >
            <option value="Alimentação">Alimentação</option>
            <option value="Transporte">Transporte</option>
            <option value="Lazer">Lazer</option>
            <option value="Moradia">Moradia</option>
            <option value="Outros">Outros</option>
        </select>
    </div>

    <div class="campo">
        <label for="usuario_pagador">
            Quem Pagou
        </label>

        <select
            id="usuario_pagador"
            name="usuario_pagador"
            required
        >

            <% usuarios.forEach(usuario => { %>

                <option value="<%= usuario.id %>">
                    <%= usuario.nome %>
                </option>

            <% }) %>

        </select>
    </div>

    <div class="campo">
        <label for="grupo_id">
            Grupo
        </label>

        <select
            id="grupo_id"
            name="grupo_id"
            required
        >

            <% grupos.forEach(grupo => { %>

                <option value="<%= grupo.id %>">
                    <%= grupo.nome %>
                </option>

            <% }) %>

        </select>
    </div>

    <div class="campo">
        <label for="data_despesa">
            Data
        </label>

        <input
            type="date"
            id="data_despesa"
            name="data_despesa"
            required
        >
    </div>

    <button type="submit">
        Salvar Despesa
    </button>

</form>
        <!-- TABELA -->
        <section class="lista-despesas">

            <h2>Despesas Cadastradas</h2>

            <table>

                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Categoria</th>
                        <th>Pagador</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                <% if (despesas && despesas.length > 0) { %>

                    <% despesas.forEach(despesa => { %>

                        <tr>

                            <td>
                                <%= despesa.descricao %>
                            </td>

                            <td>
                                R$ <%= Number(despesa.valor).toFixed(2) %>
                            </td>

                            <td>
                                <%= despesa.categoria %>
                            </td>

                            <td>
                                <%= despesa.usuario_pagador %>
                            </td>

                            <td>
                                <%= new Date(
                                    despesa.data_despesa
                                ).toLocaleDateString('pt-BR') %>
                            </td>

                            <td>

                                <a
                                    href="/despesas/excluir/<%= despesa.id %>"
                                    onclick="return confirm('Deseja excluir esta despesa?')"
                                >
                                    Excluir
                                </a>

                            </td>

                        </tr>

                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="6">
                            Nenhuma despesa cadastrada.
                        </td>
                    </tr>

                <% } %>

                </tbody>

            </table>

        </section>

    </main>

</div>

</body>
</html>