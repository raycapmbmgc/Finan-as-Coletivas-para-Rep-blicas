<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quem Deve Para Quem | Rateio+</title>
    <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

<div class="container">

    <aside class="sidebar">
        <div class="logo">
            <h2>Rateio+</h2>
        </div>

        <nav>
            <ul>
                <li><a href="/dashboard/<%= grupoId %>">Dashboard</a></li>
                <li><a href="/despesas/<%= grupoId %>">Despesas</a></li>
                <li><a href="/saldos/<%= grupoId %>">Quem Deve Para Quem</a></li>
                <li><a href="/grupos">Membros</a></li>
                <li><a href="/metas/<%= grupoId %>">Fundo de Reserva</a></li>
            </ul>
        </nav>
    </aside>

    <main class="content">

        <header class="header">
            <h1>Quem Deve Para Quem</h1>
            <p>Visualize os saldos entre os participantes.</p>
        </header>

        <!-- RESUMO REAL -->
        <section class="saldo-geral">

            <h2>Resumo dos Saldos</h2>

            <table>

                <thead>
                    <tr>
                        <th>Pessoa</th>
                        <th>Entradas</th>
                        <th>Saídas</th>
                        <th>Saldo</th>
                    </tr>
                </thead>

                <tbody>

                    <% pessoas.forEach(p => { %>
                        <tr>
                            <td><%= p %></td>

                            <td>
                                R$ <%= movimentacoes
                                    .filter(m => m.responsavel === p && m.tipo === 'entrada')
                                    .reduce((a,b)=>a+Number(b.valor),0) %>
                            </td>

                            <td>
                                R$ <%= movimentacoes
                                    .filter(m => m.responsavel === p && m.tipo === 'saida')
                                    .reduce((a,b)=>a+Number(b.valor),0) %>
                            </td>

                            <td>
                                <%
                                    const entrada = movimentacoes
                                        .filter(m => m.responsavel === p && m.tipo === 'entrada')
                                        .reduce((a,b)=>a+Number(b.valor),0);

                                    const saida = movimentacoes
                                        .filter(m => m.responsavel === p && m.tipo === 'saida')
                                        .reduce((a,b)=>a+Number(b.valor),0);

                                    const saldo = entrada - saida;
                                %>

                                <% if (saldo >= 0) { %>
                                    + R$ <%= saldo %>
                                <% } else { %>
                                    - R$ <%= Math.abs(saldo) %>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>

                </tbody>

            </table>

        </section>

        <!-- ACERTOS SIMPLES -->
        <section class="acertos">

            <h2>Quem Deve Para Quem</h2>

            <% if (saldo < 0) { %>
                <div class="card-acerto">
                    <p><strong>Existe saldo negativo no grupo</strong></p>
                </div>
            <% } else { %>
                <div class="card-acerto">
                    <p><strong>Grupo equilibrado</strong></p>
                </div>
            <% } %>

        </section>

        <!-- REGISTRAR PAGAMENTO -->
        <section class="registrar-pagamento">

            <h2>Registrar Pagamento</h2>

            <form action="/saldos/<%= grupoId %>" method="POST">

                <div class="campo">
                    <label>Quem Pagou</label>
                    <select name="quemPagou">
                        <% pessoas.forEach(p => { %>
                            <option><%= p %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="campo">
                    <label>Valor</label>
                    <input type="number" name="valor" placeholder="0,00" required>
                </div>

                <button type="submit">Confirmar Pagamento</button>

            </form>

        </section>

    </main>

</div>

</body>
</html>