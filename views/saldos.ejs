<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quem Deve Para Quem | Rateio+</title>
    <link rel="stylesheet" href="css/style.css" />
</head>
<body>

<div class="container">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <h2>Rateio+</h2>
        </div>

        <nav>
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/despesas">Despesas</a></li>
                <li><a href="/saldos">Quem Deve Para Quem</a></li>
                <li><a href="/grupos">Membros</a></li>
                <li><a href="/metas">Fundo de Reserva</a></li>
                <li><a href="#">Configurações</a></li>
            </ul>
        </nav>

    </aside>

    <!-- CONTEÚDO -->
    <main class="content">

        <header class="header">
            <h1>Quem Deve Para Quem</h1>
            <p>Visualize os saldos entre os participantes.</p>
        </header>

        <!-- RESUMO DE SALDOS -->
        <section class="saldo-geral">

            <h2>Resumo dos Saldos</h2>

            <table>

                <thead>
                    <tr>
                        <th>Pessoa</th>
                        <th>Pagou</th>
                        <th>Deveria Pagar</th>
                        <th>Saldo</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Andrielle</td>
                        <td>R$ 300,00</td>
                        <td>R$ 150,00</td>
                        <td>+ R$ 150,00</td>
                    </tr>

                    <tr>
                        <td>Rayca</td>
                        <td>R$ 100,00</td>
                        <td>R$ 150,00</td>
                        <td>- R$ 50,00</td>
                    </tr>

                    <tr>
                        <td>Natalie</td>
                        <td>R$ 50,00</td>
                        <td>R$ 150,00</td>
                        <td>- R$ 100,00</td>
                    </tr>

                    <tr>
                        <td>Tayna</td>
                        <td>R$ 150,00</td>
                        <td>R$ 150,00</td>
                        <td>R$ 0,00</td>
                    </tr>

                </tbody>

            </table>

        </section>

        <!-- ACERTOS -->
        <section class="acertos">

            <h2>Quem Deve Para Quem</h2>

            <div class="card-acerto">
                <p><strong>Rayca</strong> deve <strong>R$ 50,00</strong> para <strong>Andrielle</strong></p>
            </div>

            <div class="card-acerto">
                <p><strong>Natalie</strong> deve <strong>R$ 100,00</strong> para <strong>Andrielle</strong></p>
            </div>

        </section>

        <!-- REGISTRAR PAGAMENTO -->
        <section class="registrar-pagamento">

            <h2>Registrar Pagamento</h2>

            <form>

                <div class="campo">
                    <label for="quemPagou">Quem Pagou</label>

                    <select id="quemPagou" name="quemPagou">
                        <option>Rayca</option>
                        <option>Natalie</option>
                        <option>Tayna</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="paraQuem">Para Quem Pagou</label>

                    <select id="paraQuem" name="paraQuem">
                        <option>Andrielle</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="valor">Valor</label>

                    <input
                        type="number"
                        id="valor"
                        name="valor"
                        placeholder="0,00"
                    >
                </div>

                <button type="submit">
                    Confirmar Pagamento
                </button>

            </form>

        </section>

    </main>

</div>

</body>
</html>
