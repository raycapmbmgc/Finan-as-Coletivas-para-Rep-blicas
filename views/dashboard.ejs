<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Rateio+</title>
    <link rel="stylesheet" href="css/style.css" />
</head>
<body>

    <div class="container">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="logo">
                <h2>Rateio+</h2>
            </div>

            <nav>
                <ul>
                    <li><a href="/dashboard">Dashboard</a></li>
                    <li><a href="/despesas">Despesas</a></li>
                    <li><a href="/saldos">Quem Deve Para Quem</a></li>
                    <li><a href="/grupos">Membros</a></li>
                    <li><a href="/metas">Fundo de Reserva</a></li>
                    <li><a href="#">Configurações</a></li>
                </ul>
            </nav>

        </aside>

        <!-- CONTEÚDO -->
        <main class="content">

            <!-- TOPO -->
            <header class="header">
                <div>
                    <h1>Olá, Rayca 👋</h1>
                    <p>Bem-vinda ao Rateio+.</p>
                </div>
            </header>

            <!-- CARDS -->
            <section class="cards">

                <div class="card">
                    <h3>Total de Despesas</h3>
                    <p>R$ 1.850,00</p>
                </div>

                <div class="card">
                    <h3>Seu Saldo</h3>
                    <p>+ R$ 150,00</p>
                </div>

                <div class="card">
                    <h3>Membros</h3>
                    <p>4</p>
                </div>

                <div class="card">
                    <h3>Fundo de Reserva</h3>
                    <p>R$ 800,00</p>
                </div>

            </section>

            <!-- BOTÕES -->
            <section class="acoes-rapidas">

                <button>Nova Despesa</button>

                <button>Ver Saldos</button>

                <button>Adicionar ao Fundo</button>

            </section>

            <!-- ÚLTIMAS DESPESAS -->
            <section class="ultimas-despesas">

                <h2>Últimas Despesas</h2>

                <table>

                    <thead>
                        <tr>
                            <th>Descrição</th>
                            <th>Valor</th>
                            <th>Pagador</th>
                            <th>Data</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>Mercado</td>
                            <td>R$ 150,00</td>
                            <td>Andrielle</td>
                            <td>01/06/2026</td>
                        </tr>

                        <tr>
                            <td>Internet</td>
                            <td>R$ 120,00</td>
                            <td>Rayca</td>
                            <td>03/06/2026</td>
                        </tr>

                        <tr>
                            <td>Produtos de Limpeza</td>
                            <td>R$ 85,00</td>
                            <td>Natalie</td>
                            <td>05/06/2026</td>
                        </tr>

                        <tr>
                            <td>Streaming</td>
                            <td>R$ 45,00</td>
                            <td>Tayna</td>
                            <td>06/06/2026</td>
                        </tr>

                    </tbody>

                </table>

            </section>

            <!-- META -->
            <section class="meta-economia">

                <h2>Meta de Economia</h2>

                <p>
                    Objetivo:
                    <strong>Viagem de fim de ano</strong>
                </p>

                <p>
                    Valor objetivo:
                    <strong>R$ 2.000,00</strong>
                </p>

                <p>
                    Valor atual:
                    <strong>R$ 1.250,00</strong>
                </p>

                <p>
                    Progresso:
                    <strong>62%</strong>
                </p>

            </section>

        </main>

    </div>

</body>
</html>
