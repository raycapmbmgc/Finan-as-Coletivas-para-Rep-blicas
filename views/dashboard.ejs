<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Rateio+</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">

    <aside class="sidebar">

        <div class="logo">
            <h2>Rateio+</h2>
        </div>

        <nav>
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/despesas">Despesas</a></li>
                <li><a href="/saldos">Quem Deve Para Quem</a></li>
                <li><a href="/grupos">Grupos</a></li>
                <li><a href="/metas">Metas</a></li>
                <li><a href="/logout">Sair</a></li>
            </ul>
        </nav>

    </aside>

    <main class="content">

        <header class="header">
            <div>
                <h1>Olá, <%= usuario ? usuario.nome : 'Usuário' %> 👋</h1>
                <p>Bem-vinda ao Rateio+</p>
            </div>
        </header>

        <section class="cards">

            <div class="card">
                <h3>Total de Despesas</h3>
                <p>R$ <%= Number(totalDespesas).toFixed(2) %></p>
            </div>

            <div class="card">
                <h3>Grupos</h3>
                <p><%= totalGrupos %></p>
            </div>

            <div class="card">
                <h3>Metas Ativas</h3>
                <p><%= metas.length %></p>
            </div>

        </section>

        <section class="acoes-rapidas">

            <button onclick="location.href='/despesas'">
                Nova Despesa
            </button>

            <button onclick="location.href='/grupos'">
                Ver Grupos
            </button>

            <button onclick="location.href='/metas'">
                Ver Metas
            </button>

        </section>

        <section class="meta-economia">

            <h2>Metas de Economia</h2>

            <% if (metas.length > 0) { %>

                <% metas.forEach(meta => { %>

                    <div class="card" style="margin-bottom:15px;">

                        <h3><%= meta.nome %></h3>

                        <p>
                            Objetivo:
                            <strong>
                                R$ <%= Number(meta.valor_objetivo).toFixed(2) %>
                            </strong>
                        </p>

                        <p>
                            Atual:
                            <strong>
                                R$ <%= Number(meta.valor_atual).toFixed(2) %>
                            </strong>
                        </p>

                        <%
                            let progresso = 0;

                            if(meta.valor_objetivo > 0){
                                progresso = (
                                    meta.valor_atual /
                                    meta.valor_objetivo
                                ) * 100;
                            }
                        %>

                        <p>
                            Progresso:
                            <strong>
                                <%= progresso.toFixed(0) %>%
                            </strong>
                        </p>

                    </div>

                <% }) %>

            <% } else { %>

                <p>Nenhuma meta cadastrada.</p>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>