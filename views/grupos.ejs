<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grupos | Rateio+</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <h2>Rateio+</h2>
        </div>

        <nav>
            <ul>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/despesas">Despesas</a></li>
                <li><a href="/saldos">Quem Deve Para Quem</a></li>
                <li><a href="/grupos">Grupos</a></li>
                <li><a href="/metas">Fundo de Reserva</a></li>
                <li><a href="#">Configurações</a></li>
            </ul>
        </nav>

    </aside>

    <!-- CONTEÚDO -->
    <main class="content">

        <header class="header">
            <h1>Grupos</h1>
            <p>Gerencie seus grupos e participantes.</p>
        </header>

        <!-- CRIAR GRUPO -->
        <section class="novo-grupo">

            <h2>Criar Grupo</h2>

            <form action="/grupos" method="POST">

                <div class="campo">

                    <label for="nomeGrupo">
                        Nome do Grupo
                    </label>

                    <input
                        id="nomeGrupo"
                        type="text"
                        name="nome"
                        placeholder="Ex: Apartamento 302"
                        required
                    >

                </div>

                <button type="submit">
                    Criar Grupo
                </button>

            </form>

        </section>

        <hr>

        <!-- LISTA DE GRUPOS -->
       <section class="lista-grupos">

    <h2>Grupos Cadastrados</h2>

    <% if (grupos && grupos.length > 0) { %>

        <ul>

            <% grupos.forEach(g => { %>

                <li style="margin-bottom:15px;">

                    <a href="/grupos/<%= g.id %>">
                        <strong><%= g.nome %></strong>
                    </a>

                    <% if (
                        typeof usuario !== 'undefined' &&
                        usuario &&
                        g.criador_id == usuario.id
                    ) { %>

                        <form
                            action="/grupos/excluir/<%= g.id %>"
                            method="POST"
                            style="display:inline;"
                        >

                            <button type="submit">
                                Excluir
                            </button>

                        </form>

                    <% } %>

                </li>

            <% }) %>

        </ul>

    <% } else { %>

        <p>Nenhum grupo cadastrado.</p>

    <% } %>

</section>

        <hr>

        <!-- NOVO PARTICIPANTE -->
        <section class="novo-participante">

            <h2>Novo Participante</h2>

            <% if (grupo) { %>

                <form
                    action="/grupos/<%= grupo.id %>/participantes"
                    method="POST"
                >

                    <div class="campo">

                        <label for="nomeParticipante">
                            Nome
                        </label>

                        <input
                            id="nomeParticipante"
                            type="text"
                            name="nome"
                            required
                        >

                    </div>

                    <div class="campo">

                        <label for="funcao">
                            Função
                        </label>

                        <select
                            id="funcao"
                            name="funcao"
                        >

                            <option value="Membro">
                                Membro
                            </option>

                            <option value="Administrador">
                                Administrador
                            </option>

                        </select>

                    </div>

                    <button type="submit">
                        Adicionar Participante
                    </button>

                </form>

            <% } else { %>

                <p>
                    Selecione um grupo para adicionar participantes.
                </p>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>